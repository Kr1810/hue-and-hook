# Copy to .env and adjust. Every value has a sensible default.

# Port the Express server listens on (Vite proxies /api here in dev)
PORT=5000

# Origin allowed by CORS (the Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# Public URL of the site, used for canonical URLs and Open Graph tags
SITE_URL=http://localhost:5000

# Set to 1 (or the number of proxies) when running behind a reverse proxy, so rate limiting sees real IPs
TRUST_PROXY=0
